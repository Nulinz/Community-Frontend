{
  "routes": [
    {
      "route": "/.well-known/assetlinks.json",
      "headers": {
        "Content-Type": "application/json",
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "route": "/.well-known/apple-app-site-association",
      "headers": {
        "Content-Type": "application/json",
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "route": "/apple-app-site-association",
      "headers": {
        "Content-Type": "application/json",
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "route": "/share",
      "rewrite": "/share/index.html"
    },
    {
      "route": "/share/*",
      "rewrite": "/share/index.html"
    },
    {
      "route": "/referral",
      "rewrite": "/referral/index.html"
    },
    {
      "route": "/referral/*",
      "rewrite": "/referral/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/icons/*",
      "/.well-known/*",
      "/apple-app-site-association",
      "/share/assets/*",
      "/share",
      "/share/*",
      "/referral/assets/*",
      "/referral",
      "/referral/*",
      "/*.{ico,png,svg,json,css,js,html}"
    ]
  },
  "mimeTypes": {
    ".json": "application/json",
    ".js": "text/javascript",
    ".mjs": "text/javascript",
    ".css": "text/css"
  }
}
